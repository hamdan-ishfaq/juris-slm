# Copy to .env (never commit .env)

# HuggingFace (downloads only)
# HF_TOKEN=hf_your_token_here

# --- Environment profile ---
ENVIRONMENT=development

TRAINING_DIR=/mnt/c/Users/mhamd/Desktop/PROJECT/juris/training
TRAINING_MOUNT_PATH=/training

# --- DEV profile (fast iteration — remove OpenRouter when project complete) ---
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=microsoft/phi-4-mini-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- AIRGAP profile (final — uncomment and clear OpenRouter key) ---
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=phi3.5:mini
# OPENROUTER_API_KEY=

OLLAMA_MODEL=qwen3:8b
OLLAMA_AUX_MODEL=qwen2.5:3b
LLM_AUX_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Ollama's automatic split leaves 4 Mistral layers on the CPU on a 6 GB GPU. 99 means all layers.
OLLAMA_NUM_GPU=99
OLLAMA_NUM_CTX=4096
# The LLM needs the GPU, so embedding and reranking stay on the CPU. See docs/DECISIONS.md, D-001.
EMBEDDING_DEVICE=cpu
RERANKER_DEVICE=cpu

DATABASE_URL=postgresql+asyncpg://juris:juris_password@db:5432/juris_db
REDIS_URL=redis://cache:6379/0

AUTH_SECRET_KEY=generate-a-long-random-secret-key-here

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8002

REGISTRATION_OPEN=true
EXPOSE_OPENAPI=true
MAX_UPLOAD_BYTES=20971520

DEV_MASTER_ENABLED=true
DEV_MASTER_EMAIL=devmaster@example.com
DEV_MASTER_PASSWORD=DevMasterPass123!

HYBRID_SEARCH_ENABLED=true
HYDE_ENABLED=false
CONTEXTUAL_RETRIEVAL_ENABLED=true
CITATION_VERIFY_ENABLED=true
RAG_MIN_RERANK_SCORE=-2.0
RAG_RRF_K=60

GRAPH_EXTRACTION_ENABLED=true
QUERY_CACHE_ENABLED=true
QUERY_CACHE_TTL_SECONDS=3600
TRACING_ENABLED=false

# Send one trace per question to a local OpenTelemetry collector, such as Jaeger. Unset means nothing is sent.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
