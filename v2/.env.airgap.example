# JurisGuard V2 — Air-gap / on-prem profile (RTX 4050 + WSL2)
# Copy to .env for fully offline deployments

ENVIRONMENT=production
LLM_PROVIDER=ollama
LLM_AUX_PROVIDER=ollama
OPENROUTER_API_KEY=

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=mistral:7b-instruct-q4_K_M
OLLAMA_AUX_MODEL=qwen2.5:0.5b

# Latency profile — no adaptive HyDE or CRAG retry in air-gap
AIRGAP_LATENCY_PROFILE=true
ADAPTIVE_HYDE_ENABLED=false
HYDE_ENABLED=false
CRAG_RETRY_ENABLED=false
GRAPH_EXTRACTION_ENABLED=false

# Optional GPU for embed/rerank when CUDA torch available in container
EMBEDDING_DEVICE=auto
RERANKER_DEVICE=auto

REGISTRATION_OPEN=false
EXPOSE_OPENAPI=false
DEV_MASTER_ENABLED=false

AUTH_SECRET_KEY=generate-a-long-random-secret-key-here
AUTH_ACCESS_EXPIRE_MINUTES=15
AUTH_REFRESH_EXPIRE_DAYS=7

HYBRID_SEARCH_ENABLED=true
QUERY_CACHE_ENABLED=true
CITATION_VERIFY_ENABLED=true
RLS_ENABLED=true

WORM_BACKEND=filesystem
WORM_FILESYSTEM_PATH=/app/data/worm

# White-label (optional)
# BRAND_NAME=Your Firm Legal AI
# BRAND_TAGLINE=On-Premise Research
# BRAND_PRIMARY_COLOR=#1e3a5f
