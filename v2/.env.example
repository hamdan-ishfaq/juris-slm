# Copy to v2/.env (never commit .env)

# HuggingFace (downloads only)
# HF_TOKEN=hf_your_token_here

# --- Phase 2 runtime ---
# Host path — Docker mounts this folder to /training inside the api container
TRAINING_DIR=/mnt/c/Users/mhamd/Desktop/PROJECT/juris/training
# In-container path (leave as-is)
TRAINING_MOUNT_PATH=/training

# Ollama — swap when fine-tune completes (see docs/TRAINING_CHECKPOINTS.md)
OLLAMA_MODEL=phi3.5
# Docker: host.docker.internal | same compose network: http://ollama:11434 | host-only API: http://localhost:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

DATABASE_URL=postgresql+asyncpg://juris:juris_password@db:5432/juris_db
REDIS_URL=redis://cache:6379/0

# Change in production
AUTH_SECRET_KEY=generate-a-long-random-secret-key-here
