# Copy to v2/.env (never commit .env)

# HuggingFace (downloads only)
# HF_TOKEN=hf_your_token_here

# --- Phase 2 runtime ---
# Host path — Docker mounts this folder to /training inside the api container
TRAINING_DIR=/mnt/c/Users/mhamd/Desktop/PROJECT/juris/training
# In-container path (leave as-is)
TRAINING_MOUNT_PATH=/training

# Ollama — on-prem inference (set LLM_PROVIDER=ollama to use)
OLLAMA_MODEL=phi3.5
# Docker: host.docker.internal | same compose network: http://ollama:11434 | host-only API: http://localhost:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434

# LLM provider: openrouter (dev/CI) | ollama (on-prem production)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# OpenRouter dev model — Phi-4 Mini (phi-3.5 has no OR endpoints; closest Microsoft mini)
OPENROUTER_MODEL=microsoft/phi-4-mini-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

DATABASE_URL=postgresql+asyncpg://juris:juris_password@db:5432/juris_db
REDIS_URL=redis://cache:6379/0

# Change in production
AUTH_SECRET_KEY=generate-a-long-random-secret-key-here

# Phase 2 retrieval (defaults shown)
HYBRID_SEARCH_ENABLED=true
HYDE_ENABLED=false
CONTEXTUAL_RETRIEVAL_ENABLED=true
CITATION_VERIFY_ENABLED=true
RAG_MIN_RERANK_SCORE=-2.0
RAG_RRF_K=60
