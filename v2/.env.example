# Copy to v2/.env (never commit .env)

# HuggingFace (downloads only)
# HF_TOKEN=hf_your_token_here

# --- Environment profile ---
# development | production (production enforces strict security checks on startup)
ENVIRONMENT=development

# --- Phase 2 runtime ---
TRAINING_DIR=/mnt/c/Users/mhamd/Desktop/PROJECT/juris/training
TRAINING_MOUNT_PATH=/training

OLLAMA_MODEL=phi3.5
OLLAMA_BASE_URL=http://host.docker.internal:11434

LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=microsoft/phi-4-mini-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

DATABASE_URL=postgresql+asyncpg://juris:juris_password@db:5432/juris_db
REDIS_URL=redis://cache:6379/0

# REQUIRED: use a long random secret (32+ chars) in production
AUTH_SECRET_KEY=generate-a-long-random-secret-key-here

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8002

# Production hardening (set for prod deploy)
REGISTRATION_OPEN=true
EXPOSE_OPENAPI=true
MAX_UPLOAD_BYTES=20971520

# Dev master — LOCAL EVAL/E2E ONLY. Must be false in production.
DEV_MASTER_ENABLED=true
DEV_MASTER_EMAIL=devmaster@example.com
DEV_MASTER_PASSWORD=DevMasterPass123!

# Phase 2 retrieval
HYBRID_SEARCH_ENABLED=true
HYDE_ENABLED=false
CONTEXTUAL_RETRIEVAL_ENABLED=true
CITATION_VERIFY_ENABLED=true
RAG_MIN_RERANK_SCORE=-2.0
RAG_RRF_K=60
