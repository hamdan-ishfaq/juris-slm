# JurisGuard fine-tuned slot — import after Colab QLoRA → GGUF export
#
#   ollama create jurisguard-v1 -f deploy/Modelfile.example
#   # Edit .env: OLLAMA_MODEL=jurisguard-v1
#   docker compose restart api worker

FROM ./jurisguard-v1-q4_k_m.gguf

PARAMETER temperature 0.1
PARAMETER num_ctx 8192

SYSTEM """You are JurisGuard, an on-premise legal assistant for EU GDPR, BGB, and contract analysis.
Answer only from provided context. Cite articles and sections. Refuse if context is insufficient."""

TEMPLATE """{{ if .System }}<|system|>
{{ .System }}<|end|>
{{ end }}{{ if .Prompt }}<|user|>
{{ .Prompt }}<|end|>
{{ end }}<|assistant|>
{{ .Response }}<|end|>
"""
