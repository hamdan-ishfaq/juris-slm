# backend/.env.example
# Copy this file to backend/.env and fill in real values.
# Never commit backend/.env to git.

# ── Required ───────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_SECRET_KEY=change-this-to-a-long-random-string-minimum-32-chars

# ── Database ───────────────────────────────────────────────────────────────
# Service name "db" matches docker-compose.yml — do not change to localhost
DATABASE_URL=postgresql+asyncpg://juris:juris_password@db:5432/juris_db

# ── Redis ──────────────────────────────────────────────────────────────────
# Service name "cache" matches docker-compose.yml — do not change to localhost
REDIS_URL=redis://cache:6379/0

# ── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Add your ngrok URL here when tunnelling for mobile access:
#   ALLOWED_ORIGINS=http://localhost:5173,https://your-url.ngrok-free.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8001,http://127.0.0.1:5173

# ── HuggingFace ────────────────────────────────────────────────────────────
# Set to 1 after models are downloaded to block all outbound HF traffic
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0

# ── Environment ────────────────────────────────────────────────────────────
# Set to "production" to disable debug endpoints entirely
ENVIRONMENT=development
